[Unit]
Description=Finanzioso Data Retention Cleanup
Documentation=file:///work/finanzioso/docs/PHASE-D.md
After=network.target postgresql.service qdrant.service
Requires=postgresql.service
Wants=qdrant.service

[Service]
Type=oneshot
User=mainrag
Group=mainrag
WorkingDirectory=/opt/mainrag

# Retention cleanup tasks:
# 1. Delete Qdrant points FIRST (before DB delete!)
# 2. Delete old prices_daily (> 5 years)
# 3. Delete old scores (> 1 year)
# 4. Delete old signals (> 1 year)
# 5. Delete old news_items (> 6 months)
ExecStart=/opt/mainrag/api/mainrag-api --mode finanzioso-retention
EnvironmentFile=/etc/mainrag/mainrag.env

# Retention can take a while for large datasets
TimeoutStartSec=3600

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/mainrag

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finanzioso-retention
