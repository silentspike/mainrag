[Unit]
Description=Finanzioso Event Finalizer (Cleanup + Dead-Letter)
Documentation=file:///work/finanzioso/docs/PHASE-D.md
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=mainrag
Group=mainrag
WorkingDirectory=/opt/mainrag

# Finalizer tasks:
# 1. Reset orphaned events (stuck in 'processing' > 15 min)
# 2. Move max-attempts events to dead-letter ('failed')
# 3. Cleanup old done/failed events (> 7 days)
ExecStart=/opt/mainrag/api/mainrag-api --mode finanzioso-finalizer
EnvironmentFile=/etc/mainrag/mainrag.env

# Quick operation - 2 minutes should be plenty
TimeoutStartSec=120

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/mainrag

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finanzioso-finalizer
