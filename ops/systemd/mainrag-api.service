[Unit]
Description=MainRAG API Server
Documentation=https://github.com/silentspike/mainrag
After=network.target postgresql.service qdrant.service
Requires=postgresql.service
Wants=qdrant.service

[Service]
Type=simple
User=mainrag
Group=mainrag
WorkingDirectory=/opt/mainrag/api
ExecStart=/opt/mainrag/api/mainrag-api
EnvironmentFile=/etc/mainrag/mainrag.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/mainrag

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mainrag-api

[Install]
WantedBy=multi-user.target
