[Unit]
Description=Start MainRAG in CPU-only mode
Documentation=https://github.com/silentspike/mainrag
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# systemd resolves WorkingDirectory before loading shell variables.
EnvironmentFile=/etc/mainrag/mainrag-cpu.env
ExecStart=/bin/sh -eu -c 'cd -- "$${MAINRAG_WORKDIR:?Set MAINRAG_WORKDIR in mainrag-cpu.env}"; exec /usr/local/bin/mainrag --cpu'
RemainAfterExit=yes
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mainrag-cpu

[Install]
WantedBy=multi-user.target
