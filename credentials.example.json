{
  "_comment": "Reference template for local-dev credentials. Copy to credentials.json, fill in real values. credentials.json is gitignored; production deployments should source secrets from /etc/mainrag/mainrag.env instead.",
  "mainrag": {
    "description": "MainRag hybrid architecture credentials",
    "architecture": "PostgreSQL + Qdrant + TEI",

    "postgresql": {
      "host": "localhost",
      "port": 5432,
      "database": "mainrag",
      "version": "18.x",

      "users": {
        "application": {
          "username": "mainrag",
          "password": "<SET_POSTGRES_APPLICATION_PASSWORD>",
          "description": "Application user; full read/write on mainrag tables"
        },
        "readonly": {
          "username": "mainrag_ro",
          "password": "<SET_POSTGRES_READONLY_PASSWORD>",
          "description": "Read-only user for reporting / analytics"
        },
        "admin": {
          "username": "admin",
          "password": "<SET_ADMIN_INITIAL_PASSWORD_THEN_ROTATE>",
          "password_hash": "<ARGON2ID_HASH_OR_BCRYPT_HASH>",
          "description": "Initial admin user. Rotate on first login."
        }
      },

      "connection_strings": {
        "rust_deadpool": "host=localhost port=5432 user=mainrag password=<SET_POSTGRES_APPLICATION_PASSWORD> dbname=mainrag",
        "psql_cli":      "PGPASSWORD='<SET_POSTGRES_APPLICATION_PASSWORD>' psql -h localhost -U mainrag -d mainrag",
        "connection_url":"postgresql://mainrag:<SET_POSTGRES_APPLICATION_PASSWORD>@localhost:5432/mainrag"
      },

      "extensions": [
        "vector (pgvector)",
        "pg_trgm",
        "pgcrypto",
        "uuid-ossp"
      ],
      "data_directory": "/data/mainrag/postgres"
    },

    "qdrant": {
      "host": "localhost",
      "rest_port": 6333,
      "grpc_port": 6334,
      "api_key": "<SET_QDRANT_API_KEY>",
      "connection_strings": {
        "rest_url":    "http://localhost:6333",
        "grpc_url":    "http://localhost:6334",
        "rust_client": "http://localhost:6334"
      },
      "collections": {
        "mainrag_chunks_gte": {
          "dimension": 768,
          "distance": "Cosine",
          "description": "Chunk embeddings (GTE-ModernBERT)"
        }
      },
      "data_directory": "/data/qdrant/storage",
      "snapshots_directory": "/data/qdrant/snapshots"
    },

    "tei": {
      "host": "localhost",
      "embeddings_port": 8091,
      "reranker_port":   8082,
      "model":           "Alibaba-NLP/gte-modernbert-base",
      "reranker_model":  "BAAI/bge-reranker-base",
      "connection_strings": {
        "embeddings_url": "http://localhost:8091",
        "reranker_url":   "http://localhost:8082"
      },
      "config": {
        "max_batch_tokens": 8192,
        "max_concurrent_requests": 128,
        "max_client_batch_size": 32,
        "cuda_memory_fraction_embeddings": 0.55,
        "cuda_memory_fraction_reranker":   0.25
      },
      "models_directory": "/data/models"
    },

    "jwt": {
      "secret":          "<GENERATE_VIA: openssl rand -base64 48>",
      "secret_previous": "<PREVIOUS_SECRET_DURING_GRACEFUL_ROTATION>",
      "algorithm":       "HS256",
      "access_token_expiry_hours": 24,
      "refresh_token_expiry_days": 30,
      "issuer":          "mainrag"
    },

    "api_key_pepper": {
      "current":  "<GENERATE_VIA: openssl rand -hex 20>",
      "previous": "<PREVIOUS_PEPPER_DURING_GRACEFUL_ROTATION>"
    },

    "api_server": {
      "host": "0.0.0.0",
      "port": 3001,
      "frontend_port": 3002,
      "cors_origins": ["http://localhost:5173", "http://localhost:3001", "http://localhost:3002"]
    }
  }
}
