# MainRag runtime configuration — reference template.
#
# Copy to /etc/mainrag/mainrag.env (root-owned, mode 600) and fill in real
# secrets before starting mainrag-api.service. systemd reads it via
# EnvironmentFile= in ops/systemd/mainrag-api.service.
#
# Generate secrets locally:
#   openssl rand -base64 48     # JWT_SECRET (≥ 48 bytes of entropy)
#   openssl rand -hex 20        # API_KEY_PEPPER
#   openssl rand -hex 32        # POSTGRES_PASSWORD, QDRANT_API_KEY

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mainrag
POSTGRES_USER=mainrag
POSTGRES_PASSWORD=<SET_POSTGRES_PASSWORD>
DATABASE_URL=postgresql://mainrag:<SET_POSTGRES_PASSWORD>@localhost:5432/mainrag

# ─── Qdrant ──────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_REST_URL=http://localhost:6333
QDRANT_API_KEY=<SET_QDRANT_API_KEY>
QDRANT_CHUNK_COLLECTION=mainrag_chunks_gte
QDRANT_EF_SEARCH=64

# ─── TEI (embedding + reranker, via docker-compose.yml) ──────────────
TEI_URL=http://localhost:8091
TEI_REST_URL=http://localhost:8091
TEI_GRPC_URL=http://localhost:50051
TEI_MODEL=Alibaba-NLP/gte-modernbert-base
EMBEDDING_MODEL_ID=Alibaba-NLP/gte-modernbert-base
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WITH_CCH=true

# Reranker model served on port 8082 by the tei-reranker compose service.
# No env var — it is baked into docker-compose.yml.

# ─── Tokenizer (pinned for reproducibility) ──────────────────────────
TOKENIZER_VERSION=hf_gte_modernbert
TOKENIZER_ASSET_PATH=/data/models/gte-modernbert-base/tokenizer.json

# ─── API server ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3002

# ─── Auth — JWT ──────────────────────────────────────────────────────
JWT_SECRET=<SET_JWT_SECRET_openssl_rand_base64_48>
JWT_SECRET_PREVIOUS=<OPTIONAL_PREVIOUS_SECRET_FOR_GRACEFUL_ROTATION>
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ─── Auth — API-Key pepper ───────────────────────────────────────────
API_KEY_PEPPER=<SET_API_KEY_PEPPER_openssl_rand_hex_20>
API_KEY_PEPPER_PREVIOUS=<OPTIONAL_PREVIOUS_PEPPER_FOR_GRACEFUL_ROTATION>

# ─── Rate limiting (auth routes only) ────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECS=60

# ─── Caches ──────────────────────────────────────────────────────────
CACHE_MAX_CAPACITY=10000
CACHE_TTL_SECS=300

# ─── Indexing pipeline ───────────────────────────────────────────────
MAX_CHUNKS_PER_FILE=1000
# Independent post-chunking budget; raising the global cap does not raise this.
# Only all-conversation chunk lists use the global cap alone. Mixed/text/code
# output uses min(global, this). This does not cap the deferred JSONL batch loop.
MAX_NON_CONVERSATION_CHUNKS_PER_FILE=500
PER_FILE_TIMEOUT_SECS=300
QUERY_EXPANSION_ENABLED=true
SEARCH_FTS_STRATEGY=union_all

# ─── Plugins ─────────────────────────────────────────────────────────
SEC_USER_AGENT=MainRag/0.1 (+https://github.com/silentspike/mainrag)

# ─── Logging ─────────────────────────────────────────────────────────
LOG_FORMAT=json
RUST_LOG=info,mainrag_api=info
